# Supabase credentials (same as web app)
EXPO_PUBLIC_SUPABASE_URL=your-supabase-url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Sentry crash reporting (optional — leave unset to disable).
# DSN is safe to commit/expose; monitoring also no-ops in development.
# This is the only variable the runtime needs.
EXPO_PUBLIC_SENTRY_DSN=your-sentry-dsn

# Source-map upload is NOT enabled — the @sentry/react-native/expo config
# plugin is intentionally absent from app.json until a real Sentry project
# exists. Enabling it additionally needs SENTRY_AUTH_TOKEN / SENTRY_ORG /
# SENTRY_PROJECT at *build* time; those are secrets, so set them in EAS rather
# than here. See the "Crash reporting" section of README.md.
